{
  "text": "<meta name=\"dash-one-writer\">\n<style>\n.bench { color:#142633; background:#edf3f1; padding:clamp(1rem,4vw,3rem); border-radius:16px; font-family:system-ui,sans-serif }\n.bench h1 {font-size:clamp(1.75rem,4vw,2.8rem); margin:.2em 0 .4em; letter-spacing:-.04em}\n.bench h2 {font-size:1.1rem;margin:0 0 1rem}\n.bench p {line-height:1.5;margin:.5em 0 1.2em}\n.bench .tools {display:flex; flex-wrap:wrap; gap:.7rem 1rem; margin:1.4rem 0 1rem}\n.bench select {background:#fff;color:#142633;border:1px solid #9bb5b1;border-radius:6px;padding:.42rem;margin-left:.35rem}\n.bench .paper {background:#fff;padding:1.25rem;border:1px solid #d2e1de;border-radius:10px;margin:1rem 0}\n.bench .barrow {display:grid;grid-template-columns:minmax(90px,1.2fr) minmax(40px,4fr) auto;gap:.55rem;align-items:center;margin:.6rem 0;font-size:.9rem}\n.bench .track {background:#edf2f3;border-radius:5px;overflow:hidden;height:.65rem}\n.bench .fill {height:100%;background:#14665e;border-radius:5px}\n.bench .fill.alt {background:#526bac}\n.bench .scroll {overflow-x:auto}\n.bench table {width:100%;border-collapse:collapse;font-variant-numeric:tabular-nums}\n.bench th,.bench td {text-align:left;padding:.65rem .35rem;border-bottom:1px solid #dbe4e4;white-space:nowrap}\n.bench .sub {color:#3e5b5d}\n</style>\n<main class=\"bench\">\n <h1>DSH 评测看板</h1>\n <p class=\"sub\">合成数据 · 用于验证本地交互与公司发布流程</p>\n <div class=\"tools\">\n  <label>评测场景<select id=\"scene\" data-draw=\"choices\" data-source=\"runs\"></select></label>\n  <label>对比指标<select id=\"metric\"><option value=\"success\">成功率</option><option value=\"latency\">中位延迟</option></select></label>\n </div>\n <section class=\"paper\"><h2>样本明细</h2><div class=\"scroll\"><table data-source=\"runs\"><thead><tr><th scope=\"col\">场景</th><th scope=\"col\">方案</th><th scope=\"col\">成功 / 总计</th><th scope=\"col\">中位延迟</th></tr></thead><tbody data-draw=\"rows\"></tbody></table></div></section>\n <section class=\"paper\"><h2>方案对比</h2><div data-draw=\"bars\" data-source=\"runs\">—</div></section>\n</main>\n<script>\nconst scene = document.querySelector('#scene');\nconst metric = document.querySelector('#metric');\nconst node = (tag, value, name) => {const el = document.createElement(tag); if (value != null) el.textContent = value; if (name) el.className = name; return el;};\nconst num = new Intl.NumberFormat('zh-CN');\nfunction currentRows() {\n const source = dash.data('runs');\n if (source.status !== 'ok') return [];\n return source.data.filter(row => !scene?.value || scene.value === row.scenario);\n}\nfunction redraw() { dash.draw('bars'); dash.draw('rows'); }\nmetric?.addEventListener('change', redraw);\ndash.draw('choices', el => {\n const data = dash.data('runs');\n if (data.status !== 'ok') return;\n const before = el.value;\n el.replaceChildren(new Option('全部场景',''), ...[...new Set(data.data.map(row => row.scenario))].map(value => new Option(value)));\n el.value = [...el.options].some(option => option.value === before) ? before : '';\n el.onchange = redraw;\n});\ndash.draw('bars', el => {\n const rows = currentRows();\n const latency = metric?.value === 'latency';\n const max = latency ? Math.max(1, ...rows.map(row => Number(row.latency_ms))) : 100;\n el.replaceChildren(...rows.map(row => {\n   const value = latency ? Number(row.latency_ms) : 100 * Number(row.success) / Number(row.total);\n   const line = node('div', null, 'barrow');\n   const track = node('div', null, 'track');\n   const fill = node('div', null, row.variant.endsWith('B') ? 'fill alt' : 'fill');\n   fill.style.width = (100 * value / max) + '%';\n   track.setAttribute('aria-hidden', 'true');\n   track.append(fill);\n   line.append(node('span', row.scenario + ' · ' + row.variant), track, node('strong', num.format(value) + (latency ? ' ms' : '%')));\n   return line;\n }));\n});\ndash.draw('rows', el => {\n el.replaceChildren(...currentRows().map(row => {\n   const tr = node('tr');\n   for (const value of [row.scenario, row.variant, row.success + ' / ' + row.total, num.format(Number(row.latency_ms)) + ' ms']) tr.append(node('td', value));\n   return tr;\n }));\n});\n</script>\n",
  "edit": {
    "by": "local",
    "byAt": "2026-11-14T06:25:25.802Z"
  }
}
