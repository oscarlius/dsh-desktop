{
  "name": "dsh-plugin-p7-company-models",
  "version": "0.1.0-dev.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "P7-managed company model catalog for DSH Desktop",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./defaults": {
      "types": "./lib/defaults.d.ts",
      "default": "./lib/defaults.js"
    },
    "./personal-memory-space-provider": {
      "types": "./lib/personal-memory-space-provider.d.ts",
      "default": "./lib/personal-memory-space-provider.js"
    }
  },
  "files": [
    "lib/**",
    "README.md",
    "contracts/**"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json --emitDeclarationOnly && tsdown",
    "typecheck": "tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run",
    "check": "yarn run typecheck && yarn run test && yarn run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5 || ~4.1.0",
    "@deepseek-ai/dsh-agent-default-model": "0.2.1-rc.3 || 0.2.2-rc.1",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-rc.3 || 0.2.2-rc.1",
