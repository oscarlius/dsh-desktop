{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p7.example.invalid/contracts/dsh-model-config-v1.schema.json",
  "title": "Proposed P7 DSH managed model configuration v1",
  "description": "Draft contract. The companion fixture is synthetic and must not be treated as production model capability evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "revision",
    "enabled",
    "defaultModel",
    "models"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "enabled": {
      "type": "boolean"
    },
    "defaultModel": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 128
    },
    "models": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/model"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "enabled": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "models": {
            "maxItems": 0
          },
          "defaultModel": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "models": {
            "maxItems": 0
          }
        }
      },
      "then": {
        "properties": {
          "defaultModel": {
            "const": null
          }
        }
      },
      "else": {
        "properties": {
          "enabled": {
            "const": true
          },
          "defaultModel": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "api",
        "contextWindow",
        "maxOutputTokens",
        "inputModalities",
        "streaming",
        "tools"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\s\\u0000-\\u001f\\u007f]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "api": {
          "enum": [
            "openai-completions",
            "openai-responses",
            "anthropic-messages"
          ]
        },
        "contextWindow": {
          "type": "integer",
          "minimum": 1
        },
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 1
        },
        "inputModalities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "text",
              "image"
            ]
          },
          "contains": {
            "const": "text"
          }
        },
        "streaming": {
          "const": true
        },
        "tools": {
          "const": true
        },
        "reasoningEfforts": {
          "oneOf": [
            {
              "const": false
            },
            {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": false,
              "properties": {
                "off": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1,
                  "maxLength": 64
                },
                "minimal": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "low": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "medium": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "high": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "xhigh": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "max": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                }
              },
              "anyOf": [
                {
                  "required": [
                    "minimal"
                  ]
                },
                {
                  "required": [
                    "low"
                  ]
                },
                {
                  "required": [
                    "medium"
                  ]
                },
                {
                  "required": [
                    "high"
                  ]
                },
                {
                  "required": [
                    "xhigh"
                  ]
                },
                {
                  "required": [
                    "max"
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  }
}
